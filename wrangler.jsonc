
{
  "name": "css-gerador-com-ia",
  "main": "worker/true",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "GEMINI_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COTA_DIARIA",
        "class_name": "CotaDiaria"
      }
    ]
  },
  "exports": {
    "CotaDiaria": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
